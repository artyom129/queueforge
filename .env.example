# Core
QUEUEFORGE_ENVIRONMENT=development
QUEUEFORGE_LOG_LEVEL=INFO
# Leave blank to disable API-key auth for local development.
QUEUEFORGE_API_KEY=

# Infrastructure
QUEUEFORGE_DATABASE_URL=postgresql+asyncpg://queueforge:queueforge@localhost:5432/queueforge
QUEUEFORGE_REDIS_URL=redis://localhost:6379/0

# Worker
QUEUEFORGE_WORKER_QUEUES=critical,default,low
QUEUEFORGE_WORKER_POLL_TIMEOUT_SECONDS=5
QUEUEFORGE_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
QUEUEFORGE_WORKER_HEARTBEAT_TTL_SECONDS=20
QUEUEFORGE_WORKER_LOST_AFTER_SECONDS=30
QUEUEFORGE_REAPER_INTERVAL_SECONDS=10

# Retry policy
QUEUEFORGE_RETRY_BASE_DELAY_SECONDS=1
QUEUEFORGE_RETRY_MAX_DELAY_SECONDS=60
QUEUEFORGE_RETRY_JITTER_RATIO=0.10

# Scheduler / outbox
QUEUEFORGE_SCHEDULER_POLL_INTERVAL_SECONDS=0.5
QUEUEFORGE_SCHEDULER_BATCH_SIZE=100
QUEUEFORGE_RECONCILIATION_INTERVAL_SECONDS=10
QUEUEFORGE_RECONCILIATION_BATCH_SIZE=500
QUEUEFORGE_OUTBOX_POLL_INTERVAL_SECONDS=0.5
QUEUEFORGE_OUTBOX_BATCH_SIZE=100

# Webhooks
QUEUEFORGE_CALLBACK_CONNECT_TIMEOUT_SECONDS=5
QUEUEFORGE_CALLBACK_READ_TIMEOUT_SECONDS=10
QUEUEFORGE_CALLBACK_MAX_ATTEMPTS=3
QUEUEFORGE_CALLBACK_BASE_DELAY_SECONDS=0.5
